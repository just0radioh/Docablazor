@namespace DocaBlazor.Shared

<li style="@(Visible ? "" : "display:none")">
    <button class="nav-item @(IsSelected ? "active" : "") @(Node.Pending ? "pending-folder" : "") @(Node.IsFolder ? "is-folder" : "is-page")"
            role="treeitem"
            aria-expanded="@(Node.IsFolder ? Expanded.ToString().ToLowerInvariant() : null)"
            @onclick="HandleClick">
        @if (!string.IsNullOrEmpty(Node.Icon))
        {
            <span class="nav-icon">@Node.Icon</span>
        }
        <span class="nav-label">@Label</span>
        @if (Node.IsFolder)
        {
            <span class="toggle-icon @(Expanded ? "open" : "")" aria-hidden="false">›</span>
        }
    </button>

    @if (Node.IsFolder)
    {
        <ul class="nested @(Expanded ? "active" : "")">
            @foreach (var child in Node.Children!)
            {
                <TreeItem Node="child"
                          Query="@Query"
                          SelectedId="@SelectedId"
                          ExpandedIds="ExpandedIds"
                          OnSelect="OnSelect"
                          OnFolderActivate="OnFolderActivate" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired] public NavNode Node { get; set; } = null!;
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public string? SelectedId { get; set; }
    [Parameter, EditorRequired] public HashSet<string> ExpandedIds { get; set; } = new();
    [Parameter] public EventCallback<NavNode> OnSelect { get; set; }
    [Parameter] public EventCallback<NavNode> OnFolderActivate { get; set; }

    private bool IsSelected => SelectedId == Node.Id;

    private bool Expanded => Node.IsFolder &&
        (ExpandedIds.Contains(Node.Id) || (!string.IsNullOrWhiteSpace(Query) && Node.MatchesQuery(Query)));

    private bool Visible => string.IsNullOrWhiteSpace(Query) || Node.MatchesQuery(Query);

    private MarkupString Label
    {
        get
        {
            var label = Node.Label ?? string.Empty;
            if (string.IsNullOrWhiteSpace(Query))
                return new MarkupString(System.Net.WebUtility.HtmlEncode(label));

            var idx = label.IndexOf(Query, StringComparison.OrdinalIgnoreCase);
            if (idx < 0 || idx + Query.Length > label.Length)
                return new MarkupString(System.Net.WebUtility.HtmlEncode(label));

            var before = System.Net.WebUtility.HtmlEncode(label[..idx]);
            var match = System.Net.WebUtility.HtmlEncode(label.Substring(idx, Query.Length));
            var after = System.Net.WebUtility.HtmlEncode(label[(idx + Query.Length)..]);
            return new MarkupString($"{before}<mark>{match}</mark>{after}");
        }
    }

    private async Task HandleClick()
    {
        if (Node.IsFolder)
            await OnFolderActivate.InvokeAsync(Node);
        else
            await OnSelect.InvokeAsync(Node);
    }
}
